# Core integrations
TELEGRAM_TOKEN=
LINKEDIN_TOKEN=
X_API_KEY=
X_API_SECRET_KEY=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LLM provider: openai | azure_openai
LLM_PROVIDER=openai

# OpenAI settings (key also used independently when IMAGE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Azure OpenAI settings (key/endpoint also used when IMAGE_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Telegram runtime mode: polling | webhook
TELEGRAM_MODE=polling
TELEGRAM_DROP_PENDING_UPDATES=true

# Webhook settings (required if TELEGRAM_MODE=webhook)
TELEGRAM_WEBHOOK_PUBLIC_URL=https://YOUR-DOMAIN.com
TELEGRAM_WEBHOOK_PATH=webhook
TELEGRAM_WEBHOOK_LISTEN=0.0.0.0
TELEGRAM_WEBHOOK_PORT=8443
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Optional bot safety and behavior settings
TELEGRAM_ALLOWED_USER_IDS=
SCRAPER_TIMEOUT_SECONDS=10

# LinkedIn reach mode (A/B/C + niche hashtag policy)
LINKEDIN_HASHTAG_CORE=#AIEngineering,#AIResearch,#LLM
LINKEDIN_HASHTAG_SECONDARY=#AIAgents,#MachineLearning,#GenerativeAI,#DeveloperTools

# First comment pipeline (disabled for now)
LINKEDIN_ENABLE_FIRST_COMMENT=false
LINKEDIN_FIRST_COMMENT_DELAY_SECONDS=90

# Optional research enrichment (keep disabled unless key is available)
ENABLE_RESEARCH_AGENT=false
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_MAX_LINKS=3

# Optional local telemetry for pipeline evolution
PIPELINE_TELEMETRY_PATH=.runtime/telemetry.jsonl

# Optional LinkedIn images (independent of text LLM provider; disabled by default)
LINKEDIN_ENABLE_IMAGES=false
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Azure images require a separately deployed image model, not the text deployment
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
# Fixed sizes: 1024x1024 | 1536x1024 | 1024x1536; quality: low | medium | high
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=low
# Per-draft cap 1-10, enforced by draft/UI layer; includes uncertain/failed attempts
IMAGE_MAX_GENERATIONS=3
# Per-request timeout 1-600 seconds; image SDK retries are disabled
IMAGE_TIMEOUT_SECONDS=180
DRAFT_STORE_PATH=.runtime/drafts.sqlite3
# Retention 1-365 days
DRAFT_RETENTION_DAYS=7

# Layered article ingestion (legacy keeps the safe fetcher, changes extraction only)
SCRAPER_MODE=layered
SCRAPER_CONNECT_TIMEOUT_SECONDS=5
SCRAPER_TOTAL_TIMEOUT_SECONDS=60
SCRAPER_MAX_ATTEMPTS=2
SCRAPER_MAX_RESPONSE_BYTES=5242880
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_TEXT_CHARS=60000
SCRAPER_MIN_INTERVAL_SECONDS=0.5
SCRAPER_CACHE_TTL_SECONDS=3600
SCRAPER_CACHE_PATH=.runtime/scrape-cache.sqlite3
SCRAPER_CACHE_MAX_ENTRIES=128
# Explicit publisher feed URLs; exact article identity is checked and excerpts labeled.
SCRAPER_FEED_URLS={}
# Optional isolated service: requires a nonempty TELEGRAM_ALLOWED_USER_IDS and dedicated token.
# No paid reader or automatic challenge bypass is configured.
SCRAPER_BROWSER_ENABLED=false
SCRAPER_BROWSER_URL=http://scraper-browser:8787
SCRAPER_BROWSER_TOKEN=
SCRAPER_BROWSER_TIMEOUT_SECONDS=25
SCRAPER_BROWSER_MAX_CONCURRENCY=1
